# Compose *interpolation* variables for this project - copy to `Groceries/.env`
# and edit there. That file is gitignored; this template is not.
#
# READ THIS FIRST, because it is the part that trips people up: docker compose
# reads TWO different .env files for two different purposes, and they are not
# interchangeable.
#
#   1. `<project dir>/.env`  -> variable interpolation in docker-compose.yml,
#                               i.e. the `${WEBAPP_PORT:-5000}` style substitution.
#                               The project directory is this one, Groceries/.
#   2. the repo-root `.env`  -> container environment, because each service says
#                               `env_file: ../.env`. That is where the store ids,
#                               USDA_API_KEY and SECRET_KEY live.
#
# Putting WEBAPP_PORT in the root .env does nothing, and putting a store id here
# does nothing either. Neither produces an error - the value just silently never
# arrives, which is the worst way for this to fail.
#
# This file is optional. Everything in it has a default in docker-compose.yml, so
# a host where port 5000 is free needs no Groceries/.env at all.

# Host port the webapp is published on. The container always listens on 5000;
# only this side of the mapping moves.
#
# Change it when something else already holds 5000. On a shared home server that
# is the normal case, not an exception - check before choosing:
#
#     ss -tln | grep -E ':5000\b'
#     docker ps --format '{{.Names}}\t{{.Ports}}' | grep 5000
#
# Pick something unlisted, then re-check it is actually free.
WEBAPP_PORT=5000
